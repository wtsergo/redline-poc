APP_NAME="Redline PoC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# SQLite by default (database/database.sqlite). For MySQL set DB_CONNECTION=mysql
# plus DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD.
DB_CONNECTION=sqlite

# Console-only application: nothing here needs a cache, queue or session table.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
